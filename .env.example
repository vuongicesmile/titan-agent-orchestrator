# URL of the Titan Control Plane capability gateway.
TITAN_CONTROL_PLANE_URL=http://127.0.0.1:8000
# Service credential issued to this orchestrator; it is never sent to a browser.
TITAN_CAPABILITY_GATEWAY_TOKEN=change-me-in-local-development
# HMAC secret shared only with Titan Control Plane. Never expose this to a browser.
TITAN_CONTEXT_SIGNING_SECRET=change-me-in-local-development
# Durable local state; use a PostgreSQL repository adapter in production.
ORCHESTRATOR_DATABASE_URL=sqlite:///./data/orchestrator.db
# Development only. Production callers must send a signed Titan context.
ORCHESTRATOR_ALLOW_DEV_CONTEXT=false
