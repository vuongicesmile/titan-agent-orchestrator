# Control Plane chạy trên máy host; container dùng host.docker.internal.
# Nếu cùng Docker network, đổi thành http://titan-api:8000.
TITAN_CONTROL_PLANE_URL=http://host.docker.internal:8000
# Phải trùng TITAN_AGENT_GATEWAY_TOKEN phía Control Plane.
TITAN_CAPABILITY_GATEWAY_TOKEN=
# Phải trùng TITAN_AGENT_CONTEXT_SIGNING_SECRET phía Control Plane.
TITAN_CONTEXT_SIGNING_SECRET=
# Cổng local của Orchestrator.
ORCHESTRATOR_PORT=8010
# Trạng thái được giữ trong named volume khi chạy Docker.
ORCHESTRATOR_DATABASE_URL=sqlite:///./data/orchestrator.db
# Compose luôn yêu cầu signed context, không bật dev bypass.
ORCHESTRATOR_ALLOW_DEV_CONTEXT=false

# Provider chính là Groq; dự phòng z.ai khi đã cấu hình ZAI_API_KEY.
# Đặt LLM_FALLBACK_PROVIDER= để tắt dự phòng. Không commit API key.
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=zai
LLM_TIMEOUT_S=30
# Maximum retries for transient read-only delegated tasks (0-5).
PLANNER_MAX_TASK_RETRIES=2

GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_MODEL=glm-4.7
ZAI_API_KEY=

# Gemini không nằm trong chuỗi dự phòng mặc định.
# Đổi LLM_PROVIDER=gemini để chọn provider này.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Tương thích cấu hình cũ: chỉ áp dụng cho provider chính.
# Các biến riêng của provider ở trên được ưu tiên hơn biến LLM_* tương ứng.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Ngân sách chờ tool gateway; timeout kết nối vẫn ngắn, không retry tool ghi.
TITAN_CAPABILITY_TIMEOUT_S=180
