# Control Plane chạy trên máy host; container dùng host.docker.internal.
# Nếu cùng Docker network, đổi thành http://titan-api:8000.
TITAN_CONTROL_PLANE_URL=http://host.docker.internal:8000
# Phải trùng TITAN_AGENT_GATEWAY_TOKEN phía Control Plane.
TITAN_CAPABILITY_GATEWAY_TOKEN=
# Phải trùng TITAN_AGENT_CONTEXT_SIGNING_SECRET phía Control Plane.
TITAN_CONTEXT_SIGNING_SECRET=
# Cổng local của Orchestrator.
ORCHESTRATOR_PORT=8010
# Trạng thái được giữ trong named volume khi chạy Docker.
ORCHESTRATOR_DATABASE_URL=sqlite:///./data/orchestrator.db
# Compose luôn yêu cầu signed context, không bật dev bypass.
ORCHESTRATOR_ALLOW_DEV_CONTEXT=false

# Planner LLM, hỗ trợ endpoint OpenAI-compatible (Groq, OpenAI, vLLM…).
# Không commit API key; đặt giá trị thật trong .env cục bộ.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_TIMEOUT_S=30
